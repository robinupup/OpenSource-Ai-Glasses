# ============================================================
# my-app 运行时配置（部署到眼镜的 /oem/etc/myapp.conf）
#
# 格式：key=value，每行一对，以 # 开头的行为注释。
# 该文件不存在或某字段缺失时，程序会回落到 core/config.c 中
# 的内置默认值，不会启动失败。
#
# 改完后用 adb 推到设备，并重启 my-app：
#   adb push myapp.conf.sample /oem/etc/myapp.conf
#   adb shell /oem/usr/bin/app_switch.sh stop
#   adb shell /oem/usr/bin/app_switch.sh myapp
# ============================================================

# -------- 1) WiFi（开机后自动连接） --------
wifi_ssid=CU_Ahta
wifi_password=xd39ad5z
# 无线网卡名，一般不用改
wifi_iface=wlan0

# -------- 2) 算法服务地址（VLM / 翻译 / 拍照搜题 共用同一台服务器） --------
# 把这里改成你自己的算法服务 IP，三个子服务端口按实际部署填写
server_host=192.168.1.7
vlm_port=8002
homework_port=8003
translate_port=8004
